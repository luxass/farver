{
  "name": "farver",
  "version": "1.0.0-beta.2",
  "description": "A tiny color library",
  "keywords": [
    "ansi",
    "color",
    "colors",
    "colour",
    "console",
    "farver",
    "support",
    "supports",
    "terminal",
    "tty"
  ],
  "homepage": "https://github.com/luxass/farver",
  "bugs": {
    "url": "https://github.com/luxass/farver/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Lucas Nørgård",
    "email": "lucasnrgaard@gmail.com",
    "url": "https://luxass.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luxass/farver.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./utils": "./dist/utils.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "playground": "pnpm build && node playground.ts",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:bun": "bun test ./test-bun",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "termenv": "catalog:runtime"
  },
  "devDependencies": {
    "@types/bun": "catalog:types",
    "@types/node": "catalog:types",
    "@vitest/browser-playwright": "catalog:testing",
    "@vitest/coverage-v8": "catalog:testing",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "oxlint-tsgolint": "catalog:dev",
    "playwright": "catalog:testing",
    "publint": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:testing"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.12.0"
}
